AVS_BIND_ADDR=0.0.0.0:9100
AVS_ISSUER=attestation-verification-service
AVS_TOKEN_TTL_SECS=300

# Path to EC P-256 private key in PEM (PKCS8).
AVS_SIGNING_KEY_PATH=./secrets/avs-signing-key.pem

# /data encryption key for Gramine secret provisioning (16 bytes = 32 hex chars).
# Dev: path to hex file (generated by ./secrets/generate-keys.sh)
# Prod: set AZURE_KEYVAULT_URL instead (managed identity fetches key from Key Vault)
DEV_DATA_KEY_PATH=./secrets/data-key.hex

# Use a full path if the library is not in the default loader path.
AVS_RATLS_VERIFY_LIB=libra_tls_verify_dcap.so

# Expected enclave identity. Use at least one of MRSIGNER or MRENCLAVE.
AVS_EXPECTED_MRSIGNER=777d23b75d3974a2a67224e49e78a45f65537861605cc0b86cb92e8d79a8d243
AVS_EXPECTED_MRENCLAVE=6463a429dc1e01c2bff30fe30a5a03249f77705f2f443f9dec3c91798c3dfad7
AVS_EXPECTED_ISV_PROD_ID=0
AVS_EXPECTED_ISV_SVN=0

# Optional allowlist for enclave endpoints.
AVS_ALLOWED_ENCLAVE_HOSTS=127.0.0.1:8080

# Debug/TCB policy controls (set to 1 only for development).
AVS_ALLOW_DEBUG_ENCLAVE=1
AVS_ALLOW_OUTDATED_TCB=1
AVS_ALLOW_HW_CONFIG_NEEDED=1
AVS_ALLOW_SW_HARDENING_NEEDED=1

# JWT signing key ID for kid header
AVS_SIGNING_KEY_ID=your-signing-key-id

# ─── Clerk authentication ─────────────────────────────────────────────────────
# Setting CLERK_JWKS_URL turns on Clerk verification on POST /v1/attest.
# When it is set, CLERK_EXPECTED_ISS is REQUIRED (AVS refuses to start without
# it). CLERK_EXPECTED_AUD must match the dashboard's hardcoded JWT template
# name ("iob-avs" — see iob-dashboard/src/hooks/use-attestation.ts).
#
# Where to find these values: Clerk Dashboard → API Keys → "Show JWT public key".
#   - JWKS URL          → CLERK_JWKS_URL
#   - Frontend API URL  → CLERK_EXPECTED_ISS  (origin only, no path/trailing slash)
#
# CLERK_EXPECTED_AUD requires a Clerk JWT Template named "iob-avs":
#   Clerk Dashboard → JWT Templates → New template "iob-avs"
#     Claims:  { "aud": "iob-avs", "publicMetadata": "{{user.public_metadata}}" }
#   The dashboard already requests tokens with this template name.

CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_EXPECTED_ISS=https://your-clerk-domain.clerk.accounts.dev
CLERK_EXPECTED_AUD=iob-avs

# Set log level
export AZDCAP_DEBUG_LOG_LEVEL=ERROR

# Set to 1 in production to refuse to autoload `.env` from the process working
# directory. Defence in depth so a stray .env can't override measurements or
# debug flags. Leave unset/0 for local dev where you rely on .env autoload.
# AVS_DISABLE_DOTENV=1
