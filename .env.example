AVS_BIND_ADDR=0.0.0.0:9100
AVS_ISSUER=attestation-verification-service
AVS_TOKEN_TTL_SECS=300

# Path to EC P-256 private key in PEM (PKCS8).
AVS_SIGNING_KEY_PATH=./secrets/avs-signing-key.pem

# Use a full path if the library is not in the default loader path.
AVS_RATLS_VERIFY_LIB=libra_tls_verify_dcap.so

# Expected enclave identity. Use at least one of MRSIGNER or MRENCLAVE.
AVS_EXPECTED_MRSIGNER=777d23b75d3974a2a67224e49e78a45f65537861605cc0b86cb92e8d79a8d243
AVS_EXPECTED_MRENCLAVE=6463a429dc1e01c2bff30fe30a5a03249f77705f2f443f9dec3c91798c3dfad7
AVS_EXPECTED_ISV_PROD_ID=0
AVS_EXPECTED_ISV_SVN=0

# Optional allowlist for enclave endpoints.
AVS_ALLOWED_ENCLAVE_HOSTS=127.0.0.1:8080

# Debug/TCB policy controls (set to 1 only for development).
AVS_ALLOW_DEBUG_ENCLAVE=1
AVS_ALLOW_OUTDATED_TCB=1
AVS_ALLOW_HW_CONFIG_NEEDED=1
AVS_ALLOW_SW_HARDENING_NEEDED=1

# JWT signing key ID for kid header
AVS_SIGNING_KEY_ID=your-signing-key-id

# Clerk JWKS URL for token verification (enables Clerk auth)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Set log level
export AZDCAP_DEBUG_LOG_LEVEL=ERROR
