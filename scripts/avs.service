# Systemd service for Attestation Verification Service (Docker)
#
# Installation:
#   sudo cp avs.service /etc/systemd/system/avs.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable avs
#   sudo systemctl start avs
#
# Logs:
#   sudo journalctl -u avs -f
#
# Prerequisites:
#   - Docker installed and running
#   - AVS signing key at /opt/iob-micres/secrets/avs-signing-key.pem
#   - Environment file at /opt/iob-micres/.env with:
#       AVS_EXPECTED_MRSIGNER=<hex>
#       AVS_EXPECTED_MRENCLAVE=<hex>
#       AVS_EXPECTED_ISV_PROD_ID=0  (required; numeric, not "any")
#       AVS_EXPECTED_ISV_SVN=0      (required; numeric, not "any")
#       AVS_ALLOW_DEBUG_ENCLAVE=1   (for debug enclaves)
#       AVS_ALLOW_OUTDATED_TCB=1    (for outdated TCB)
#       CLERK_JWKS_URL=<clerk jwks url>     (enables Clerk auth + role extraction)
#       CLERK_EXPECTED_ISS=<clerk issuer>   (required when CLERK_JWKS_URL is set)
#       CLERK_EXPECTED_AUD=iob-avs          (Clerk JWT template audience)

[Unit]
Description=Attestation Verification Service (Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
StartLimitInterval=300
StartLimitBurst=5
EnvironmentFile=/opt/iob-micres/.env

# Stop and remove any existing container
ExecStartPre=-/usr/bin/docker stop avs
ExecStartPre=-/usr/bin/docker rm avs

# Pull latest image with retry, fallback to cached image if pull fails
ExecStartPre=-/bin/bash -c 'docker pull ghcr.io/relational-network/attestation-verification-service:staging-latest || echo "Pull failed, using cached image"'

# Run the AVS container
# - Uses host networking for enclave communication
# - Mounts signing key for JWT issuance
# - Mounts secrets dir for data key and TLS certs
# - Reads measurements from environment file
ExecStart=/usr/bin/docker run --rm --name avs \
    --network host \
    -v /opt/iob-micres/secrets:/secrets:ro \
    -e AVS_BIND_ADDR=127.0.0.1:9100 \
    -e AVS_SIGNING_KEY_PATH=/secrets/avs-signing-key.pem \
    -e AVS_EXPECTED_MRSIGNER=${AVS_EXPECTED_MRSIGNER} \
    -e AVS_EXPECTED_MRENCLAVE=${AVS_EXPECTED_MRENCLAVE} \
    -e AVS_ALLOW_DEBUG_ENCLAVE \
    -e AVS_ALLOW_OUTDATED_TCB \
    -e AVS_ALLOW_HW_CONFIG_NEEDED \
    -e AVS_ALLOW_SW_HARDENING_NEEDED \
    -e AVS_EXPECTED_ISV_PROD_ID \
    -e AVS_EXPECTED_ISV_SVN \
    -e CLERK_JWKS_URL \
    -e CLERK_EXPECTED_ISS \
    -e CLERK_EXPECTED_AUD \
    -e DEV_DATA_KEY_PATH=/secrets/data-key.hex \
    -e AZDCAP_COLLATERAL_VERSION \
    -e AZDCAP_DEBUG_LOG_LEVEL \
    -e RA_TLS_ALLOW_DEBUG_ENCLAVE_INSECURE \
    -e RA_TLS_ALLOW_OUTDATED_TCB_INSECURE \
    -e RA_TLS_ALLOW_HW_CONFIG_NEEDED \
    -e RA_TLS_ALLOW_SW_HARDENING_NEEDED \
    -e RUST_LOG \
    ghcr.io/relational-network/attestation-verification-service:staging-latest

ExecStop=/usr/bin/docker stop avs

# Health check - non-fatal, just for observability
ExecStartPost=/bin/bash -c 'for i in {1..60}; do sleep 1; curl -sf http://127.0.0.1:9100/health && exit 0; done; echo "AVS health check did not respond within 60s (non-fatal)"'

[Install]
WantedBy=multi-user.target
